# Neon Postgres — from `vercel env pull` after `vercel integration add neon`
DATABASE_URL=

# Featherless AI — same key as world-sim
FEATHERLESS_API_KEY=
# Optional override; defaults to Qwen/Qwen2.5-14B-Instruct
FEATHERLESS_MODEL=

# Gemini Live — voice mode. Server-only: the browser only ever gets a single-use,
# 30-minute token minted by /api/voice/session. Without it, voice says it is unavailable
# and the text assistant carries on as before.
# (`Gemini_API`, as it is named in Vercel, is accepted too.)
GEMINI_API_KEY=
# Optional override; defaults to gemini-3.8-live
GEMINI_LIVE_MODEL=
# Optional. Signs voice booking proposals (lib/pending.ts). Derived from GEMINI_API_KEY if unset.
VOICE_SIGNING_SECRET=

# The shared password that unlocks the site (proxy.ts). Sessions last 7 minutes.
# Named `Password` in Vercel; PASSWORD also works. If unset, production stays locked
# and local dev runs unlocked.
Password=
